{
    "name": "omnibus/canada-post",
    "type": "library",
    "description": "Omnibus Canada Post: rates, non-contract shipments and labels, tracking and post offices - the REST (XML) web services.",
    "keywords": [
        "shipping",
        "carrier",
        "omnibus",
        "canada post"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnibus": "^2.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\CanadaPost\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\CanadaPost\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
